<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/orbital_dark_blue">

    <include
        android:id="@+id/main_sidebar"
        android:layout_width="match_parent"
        android:layout_height="92dp"
        layout="@layout/layout_main_sidebar"/>

    <View
        android:id="@+id/view_accent"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/sky_cyan"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@color/sky_header_blue">

            <TextView
                android:text="DOWNLOADS"
                android:textColor="@color/sky_white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

            <Button
                android:id="@+id/btn_change_location"
                android:text="CHANGE DOWNLOAD LOCATION"
                android:layout_width="230dp"
                android:layout_height="42dp"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_downloads"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="12dp"/>

        <TextView
            android:id="@+id/tv_empty"
            android:text="NO DOWNLOADED FILES"
            android:textColor="@color/sky_white"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
