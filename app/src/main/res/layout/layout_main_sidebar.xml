<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="92dp"
    android:background="@color/sky_header_blue">

    <com.orbital.iptv.ui.widget.GlobalDateTimeView
        android:id="@+id/tv_global_datetime"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:textColor="@color/sky_cyan"
        android:textSize="11sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:id="@+id/main_sidebar_container"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="@color/sky_header_blue"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:fillViewport="true"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <LinearLayout
            android:id="@+id/main_sidebar_scroll"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:id="@+id/nav_home" android:layout_width="108dp" android:layout_height="48dp" android:layout_marginEnd="6dp" android:gravity="center" android:text="HOME" android:textColor="@color/sky_white" android:textSize="13sp" android:textStyle="bold" android:focusable="true" android:clickable="true"/>
            <TextView android:id="@+id/nav_live_tv" android:layout_width="108dp" android:layout_height="48dp" android:layout_marginEnd="6dp" android:gravity="center" android:text="LIVE TV" android:textColor="@color/sky_white" android:textSize="13sp" android:textStyle="bold" android:focusable="true" android:clickable="true"/>
            <TextView android:id="@+id/nav_movies" android:layout_width="108dp" android:layout_height="48dp" android:layout_marginEnd="6dp" android:gravity="center" android:text="MOVIES" android:textColor="@color/sky_white" android:textSize="13sp" android:textStyle="bold" android:focusable="true" android:clickable="true"/>
            <TextView android:id="@+id/nav_series" android:layout_width="108dp" android:layout_height="48dp" android:layout_marginEnd="6dp" android:gravity="center" android:text="SERIES" android:textColor="@color/sky_white" android:textSize="13sp" android:textStyle="bold" android:focusable="true" android:clickable="true"/>
            <TextView android:id="@+id/nav_search" android:layout_width="108dp" android:layout_height="48dp" android:layout_marginEnd="6dp" android:gravity="center" android:text="SEARCH" android:textColor="@color/sky_white" android:textSize="13sp" android:textStyle="bold" android:focusable="true" android:clickable="true"/>
            <TextView android:id="@+id/nav_favourites" android:layout_width="112dp" android:layout_height="48dp" android:layout_marginEnd="6dp" android:gravity="center" android:text="FAVOURITES" android:textColor="@color/sky_white" android:textSize="12sp" android:textStyle="bold" android:focusable="true" android:clickable="true"/>
            <TextView android:id="@+id/nav_downloads" android:layout_width="118dp" android:layout_height="48dp" android:layout_marginEnd="6dp" android:gravity="center" android:text="DOWNLOADS" android:textColor="@color/sky_white" android:textSize="12sp" android:textStyle="bold" android:focusable="true" android:clickable="true"/>
            <TextView android:id="@+id/nav_records" android:layout_width="108dp" android:layout_height="48dp" android:layout_marginEnd="6dp" android:gravity="center" android:text="RECORDS" android:textColor="@color/sky_white" android:textSize="13sp" android:textStyle="bold" android:focusable="true" android:clickable="true"/>
            <TextView android:id="@+id/nav_settings" android:layout_width="108dp" android:layout_height="48dp" android:layout_marginEnd="6dp" android:gravity="center" android:text="SETTINGS" android:textColor="@color/sky_white" android:textSize="13sp" android:textStyle="bold" android:focusable="true" android:clickable="true"/>
            <TextView android:id="@+id/nav_list_users" android:layout_width="112dp" android:layout_height="48dp" android:layout_marginEnd="6dp" android:gravity="center" android:text="LIST USERS" android:textColor="@color/sky_white" android:textSize="12sp" android:textStyle="bold" android:focusable="true" android:clickable="true"/>
            <TextView android:id="@+id/nav_exit" android:layout_width="94dp" android:layout_height="48dp" android:gravity="center" android:text="EXIT" android:textColor="@color/sky_white" android:textSize="13sp" android:textStyle="bold" android:focusable="true" android:clickable="true"/>
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tv_app_name"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_gravity="top|start"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:text="SE IPTV PLAYER"
        android:textColor="@color/sky_cyan"
        android:textSize="11sp"
        android:textStyle="bold" />

</FrameLayout>