+    private fun migrateLegacyCompletedDownloads() {
+        if (legacyMigrationRunning) return
+        legacyMigrationRunning = true
+        Thread {
+            var changed = false
+            for (item in DownloadStore.all(this)) {
+                if (item.status != "COMPLETED" || item.uri.isBlank()) continue
+                val uri = runCatching { Uri.parse(item.uri) }.getOrNull() ?: continue
+                if (uri.scheme != "file") continue
+                val file = File(uri.path ?: continue)
+                if (!file.isFile || file.length() <= 0L) continue
+                if (!file.absolutePath.contains("/Android/data/\${packageName}/", ignoreCase = true)) continue
+                runCatching {
+                    val newUri = PublicMediaStorage.importDownloadFile(
+                        this, file, file.name, PublicMediaStorage.mimeForName(file.name)
+                    )
+                    if (newUri != null) {
+                        DownloadStore.updateUri(this, item.id, newUri.toString())
+                        changed = true
+                    }
+                }
+            }
+            if (changed) runOnUiThread { refresh() }
+            legacyMigrationRunning = false
+        }.start()
+    }
+
     private fun openFileLocation(item: DownloadItem) {
         if (!DownloadFileOperations.isAvailable(this, item.uri)) {
             Toast.makeText(this, "FILE IS NOT AVAILABLE YET", Toast.LENGTH_SHORT).show()
             return
         }
-        val tree = DownloadFileOperations.parentTreeUri(item.uri)
+        val uri = Uri.parse(item.uri)
+        val tree = when {
+            PublicMediaStorage.isMediaStoreUri(uri) -> PublicMediaStorage.downloadFolderTreeUri()
+            else -> DownloadFileOperations.parentTreeUri(item.uri)
+        }
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O && tree != null) {
+            val folderUri = runCatching {
+                DocumentsContract.buildDocumentUri(
+                    tree.authority ?: return@runCatching null,
+                    DocumentsContract.getTreeDocumentId(tree)
+                )
+            }.getOrNull()
+            if (folderUri != null) {
+                val viewFolder = Intent(Intent.ACTION_VIEW).apply {
+                    setDataAndType(folderUri, DocumentsContract.Document.MIME_TYPE_DIR)
+                    addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+                }
+                if (runCatching { startActivity(viewFolder); true }.getOrDefault(false)) return
+            }
+        }
+        val intent = Intent(Intent.ACTION_OPEN_DOCUMENT_TREE).addFlags(
+            Intent.FLAG_GRANT_READ_URI_PERMISSION or
+            Intent.FLAG_GRANT_WRITE_URI_PERMISSION or
+            Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION
+        )
+        val initialTree = when {
+            PublicMediaStorage.isMediaStoreUri(uri) -> PublicMediaStorage.downloadFolderTreeUri()
+            else -> tree
+        }
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O && initialTree != null) {
+            intent.putExtra(DocumentsContract.EXTRA_INITIAL_URI, initialTree)
+        }
+        runCatching { startActivityForResult(intent, REQUEST_OPEN_LOCATION) }
+            .onFailure { Toast.makeText(this, "FILE MANAGER NOT AVAILABLE", Toast.LENGTH_SHORT).show() }
+    }
