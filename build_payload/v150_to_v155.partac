+            PublicMediaStorage.downloadFolderTreeUri()
+        } else {
+            DownloadFileOperations.parentTreeUri(item.uri)
+        }
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O && currentTree != null) {
