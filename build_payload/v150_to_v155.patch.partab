diff --git a/app/src/main/java/com/orbital/iptv/recording/RecordingPublicStorage.kt b/app/src/main/java/com/orbital/iptv/recording/RecordingPublicStorage.kt
new file mode 100644
index 0000000..0612364
--- /dev/null
+++ b/app/src/main/java/com/orbital/iptv/recording/RecordingPublicStorage.kt
@@ -0,0 +1,33 @@
+package com.orbital.iptv.recording
+
+import android.content.Context
+import android.net.Uri
+import android.os.Build
+import android.provider.MediaStore
+import com.orbital.iptv.utils.PublicMediaStorage
+import java.io.File
+
+object RecordingPublicStorage {
+    fun migrateCompleted(context: Context, record: RecordingEntity): Uri? {
+        if (record.fileUri.isNotBlank()) return Uri.parse(record.fileUri)
+        if (record.filePath.isBlank()) return null
+        val file = File(record.filePath)
+        if (!file.isFile || file.length() <= 0L) return null
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.Q) return null
+        return PublicMediaStorage.importRecordingFile(
+            context,
+            file,
+            file.name,
+            PublicMediaStorage.mimeForName(file.name)
+        )
+    }
+
+    fun locationUri(record: RecordingEntity): Uri? {
+        if (record.fileUri.isNotBlank()) return Uri.parse(record.fileUri)
+        return null
+    }
+
+    fun folderTreeUri(): Uri = PublicMediaStorage.recordingFolderTreeUri()
+
+    fun isPublicMediaUri(uri: Uri): Boolean = PublicMediaStorage.isMediaStoreUri(uri)
+}
