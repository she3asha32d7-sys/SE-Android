@@ -128,6 +119,64 @@ class SeriesDetailActivity : AppCompatActivity() {
         loadSeriesInfo(seriesId, seriesName)
     }
 
+    private fun showSeriesPlayerChooser() {
+        val dialog = AlertDialog.Builder(this, R.style.Theme_SE_SeriesPlayerDialog)
+            .setTitle("PLAYER FOR THIS SERIES")
+            .setItems(arrayOf("SE PLAYER", "OPEN WITH")) { _, which ->
+                when (which) {
+                    0 -> {
+                        SeriesPlayerPreference.setSePlayer(this, seriesId)
+                        Toast.makeText(this, "SE PLAYER SET FOR THIS SERIES", Toast.LENGTH_SHORT).show()
+                    }
+                    1 -> showExternalSeriesPlayerChooser()
+                }
+            }
+            .setNegativeButton("CANCEL", null)
+            .create()
+        dialog.setOnShowListener {
+            dialog.listView?.post {
+                dialog.listView?.getChildAt(0)?.requestFocus()
+            }
+        }
+        dialog.show()
+    }
+
+    private fun showExternalSeriesPlayerChooser() {
+        val probe = Intent(Intent.ACTION_VIEW).apply {
+            setDataAndType(android.net.Uri.parse("https://example.com/video.mp4"), "video/*")
+        }
+        val activities = packageManager.queryIntentActivities(probe, PackageManager.MATCH_DEFAULT_ONLY)
+            .asSequence()
+            .filter { it.activityInfo?.packageName != packageName }
+            .distinctBy { it.activityInfo?.packageName }
+            .sortedBy { it.loadLabel(packageManager).toString().lowercase() }
+            .toList()
+
+        if (activities.isEmpty()) {
+            Toast.makeText(this, "NO EXTERNAL VIDEO PLAYER FOUND", Toast.LENGTH_LONG).show()
+            return
+        }
+
+        val labels = activities.map { it.loadLabel(packageManager).toString().ifBlank { it.activityInfo.packageName } }
+        val dialog = AlertDialog.Builder(this, R.style.Theme_SE_SeriesPlayerDialog)
+            .setTitle("OPEN WITH")
+            .setItems(labels.toTypedArray()) { _, which ->
+                val info = activities.getOrNull(which) ?: return@setItems
+                val chosenPackage = info.activityInfo.packageName
+                val chosenLabel = labels.getOrNull(which) ?: chosenPackage
+                SeriesPlayerPreference.setExternalPlayer(this, seriesId, chosenPackage, chosenLabel)
+                Toast.makeText(this, "$chosenLabel SET FOR THIS SERIES", Toast.LENGTH_SHORT).show()
+            }
+            .setNegativeButton("CANCEL", null)
+            .create()
+        dialog.setOnShowListener {
+            dialog.listView?.post {
+                dialog.listView?.getChildAt(0)?.requestFocus()
+            }
+        }
+        dialog.show()
+    }
+
